# ===========================================================================
#  MAX AI Bot — .env.example  (copy to .env and fill in real values)
#  NO REAL SECRETS HERE — Pavel fills these in. Tokens below are PLACEHOLDERS.
# ===========================================================================

# ---- MAX Bot ----
# Token from MAX business console (business.max.ru -> Chat-bots -> token).
# Sent ONLY via Authorization header; never in query.
MAX_BOT_TOKEN=__REPLACE_WITH_MAX_BOT_TOKEN__
# Current, non-deprecated API domain (do NOT use platform-api.max.ru).
MAX_API_BASE=https://platform-api2.max.ru
# HTTPS webhook endpoint (prod). Must be HTTPS + trusted CA (Let's Encrypt/Минцифры).
MAX_WEBHOOK_URL=https://your-domain.example/webhook/max
# Dev = true (long polling). Prod = false (webhook).
MAX_USE_POLLING=true
# Comma-separated numeric admin ids allowed to run admin commands.
MAX_ADMIN_USER_IDS=__REPLACE_WITH_ADMIN_USER_ID__

# ---- Hermes (RZA) ----
# auto = try HTTP, fall back to CLI. none = always use local LLM.
HERMES_MODE=auto
# HTTP endpoint exposed by Hermes on the host (Docker: host.docker.internal).
HERMES_RZA_URL=http://host.docker.internal:9119/api/hermes/route
# CLI fallback command.
HERMES_RZA_CLI=hermes peer dm rza

# ---- LLM (primary) — MiniMax via Anthropic-style Messages API ----
LLM_PROVIDER=minimax
# Preferred alias. If set, it takes priority over LLM_API_KEY.
LLM_PRIMARY_API_KEY=__REPLACE_WITH_MINIMAX_API_KEY__
# Backward-compatible alias; use the same MiniMax key only when needed.
LLM_API_KEY=__REPLACE_WITH_MINIMAX_API_KEY__
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3
# "anthropic" (Messages API) or "openai" (chat/completions)
LLM_PRIMARY_STYLE=anthropic

# ---- LLM (fallback) — StepFun via OpenAI-style chat/completions ----
LLM_FALLBACK_PROVIDER=stepfun
LLM_FALLBACK_API_KEY=__REPLACE_WITH_STEPFUN_API_KEY__
LLM_FALLBACK_BASE_URL=https://api.stepfun.ai/v1
LLM_FALLBACK_MODEL=step-3.7-flash
LLM_FALLBACK_STYLE=openai

# ---- Web search ----
# duckduckgo | searxng | whoogle | librex
WEB_SEARCH_BACKEND=duckduckgo
SEARXNG_URL=
WHOOGLE_URL=
LIBREX_URL=
SEARX_SPACE_URL=https://searx.space

# ---- Parsers ----
SCRAPLING_ENABLED=true
CRAWLEE_ENABLED=false

# ---- App ----
LOG_LEVEL=INFO
# SQLite file (aiosqlite). Volume-mounted in Docker.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
APP_HOST=0.0.0.0
APP_PORT=8080
WEBHOOK_PATH=/webhook/max
